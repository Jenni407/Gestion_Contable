# ============================================================
# Variables de entorno del Sistema de Gestión Contable
# Copia este archivo como .env y ajusta los valores.
# NUNCA subas .env ni valores reales al repositorio.
# ============================================================

# ---------- Backend (Spring Boot) ----------
# Puerto interno del backend
SERVER_PORT=8080

# Cadena de conexión JDBC (SQLite por defecto)
DB_URL=jdbc:sqlite:BD/servicio_contable.db

# Clave para firmar los tokens JWT (obligatoria; usa un valor largo y aleatorio)
JWT_SECRET=cambia-esta-clave-por-un-valor-largo-y-aleatorio

# Credenciales SMTP (Gmail). Usa una "Contraseña de aplicación".
GMAIL_USER=soporte.tecnico.gt058@gmail.com
GMAIL_APP_PASSWORD=tu-app-password

# Clave AES para cifrar las credenciales de los clientes.
# IMPORTANTE: debe coincidir con la usada para cifrar los datos existentes,
# de lo contrario no se podrán desencriptar las credenciales guardadas.
APP_ENCRYPTION_KEY=OficinaSecret123

# Orígenes permitidos por CORS (separados por coma)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# URL pública del portal (para enlaces en correos)
PORTAL_URL=http://localhost:5173

# ---------- Frontend (Vite) ----------
# URL base del backend tal como la ve el navegador
VITE_API_URL=http://localhost:8080/api
