# Bloque para AGREGAR a tu Caddy centralizado (caddy-central/).
# NO reescribas el archivo de Caddy; solo añade este bloque de dominio.

gestioncredenciales.duckdns.org {
    encode gzip zstd

    # El frontend de esta app publica nginx en el puerto 8082 del host.
    # Caddy central usa host.docker.internal (host-gateway) para alcanzarlo.
    reverse_proxy host.docker.internal:8082
}

# NOTAS:
# - Caddy obtiene y renueva automáticamente el certificado HTTPS (Let's Encrypt)
#   para gestioncredenciales.duckdns.org. Tras añadir el bloque y recargar,
#   el sitio pasará de http:// a https://.
# - No expongas el puerto 8082 al exterior; solo Caddy debe alcanzarlo.
